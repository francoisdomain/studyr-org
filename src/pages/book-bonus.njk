---
# One Bonus Challenges discussion page per book with bonusChallenges: true → /<book>/bonus-challenges/
layout: layouts/base.njk
pagination:
  data: collections.booksWithBonusChallenges
  size: 1
  alias: book
permalink: "{{ book.url }}bonus-challenges/"
eleventyComputed:
  title: "{{ book.data.series }} Vol.{{ book.data.volume }} Bonus Challenges"
  description: "Share how you solved the {{ book.data.series }} Vol.{{ book.data.volume }} challenges."
---
<section class="section container">
  <p class="breadcrumb"><a href="{{ book.url }}">{{ book.data.series }} Vol.{{ book.data.volume }}</a> / <a href="/bonus-challenges/">Bonus Challenges</a></p>
  <h1>{{ book.data.series }} Vol.{{ book.data.volume }} Bonus Challenges</h1>
  <p>How did you solve the challenges?</p>
  <p>Did you come up with interesting ones you would like to share with the community?</p>

  {% include "partials/comments.njk" %}
</section>
