{%- set pageTitle = (title + " – " + site.name) if (title and page.url != "/") else (site.name + " – " + site.tagline) -%}
{%- set pageDescription = description or site.description -%}
{%- set ogImage = ogImage or "/assets/img/favicon.png" -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) }}">
  <meta property="og:image" content="{{ ogImage | absoluteUrl(site.url) }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <link rel="icon" href="/assets/img/favicon.png" type="image/png">
  <link rel="preload" href="/assets/fonts/red-hat-display-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/red-hat-display-900.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">
  <script src="/assets/js/main.js" defer></script>
  {%- if jsonLd %}
  <script type="application/ld+json">{{ jsonLd | json | safe }}</script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}

  <main id="main">
{{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
</body>
</html>
